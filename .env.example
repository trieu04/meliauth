NODE_ENV=development
PORT=3000
APP_PUBLISHED_PORT=3000
API_PREFIX=api/v1

DB_HOST=localhost
DB_PORT=5432
DB_PUBLISHED_PORT=5432
DB_USERNAME=meliauth
DB_PASSWORD=meliauth
DB_NAME=meliauth
DB_SSL=false

# Required by `pnpm seed`; the password must contain at least 8 characters.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-this-password
SEED_ADMIN_DISPLAY_NAME=Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-this-user-password

# Generate with: pnpm keys:generate
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# PEM can alternatively be injected directly (escaped newlines are accepted):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
JWT_KEY_ID=meliauth-2026-01
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=service-a,service-b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Only parent/sibling domains can share browser cookies. Use an empty value for host-only cookies.
COOKIE_DOMAINS=.example.com
COOKIE_ACCESS_NAME=meliauth_access
COOKIE_REFRESH_NAME=meliauth_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

CORS_ORIGINS=https://app.example.com,https://admin.example.com

# SMTP is required for forgot-password emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MeliAuth <no-reply@example.com>
PASSWORD_RESET_TTL=15m
EMAIL_VERIFICATION_TTL=15m

# Optional Google sign-in. Endpoint returns 503 while this is empty.
GOOGLE_CLIENT_ID=
